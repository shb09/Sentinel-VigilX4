{
  "manifest_version": 3,
  "name": "Sentinel",
  "version": "0.9.0",
  "description": "Sentinel authorization layer — live protection status",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/demo/*",
        "http://127.0.0.1/demo/*"
      ],
      "js": [
        "classify.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinel@local"
    }
  }
}