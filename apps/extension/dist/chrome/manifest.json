{
  "manifest_version": 3,
  "name": "Sentinel",
  "version": "0.8.0",
  "description": "Sentinel authorization layer — live protection status",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}